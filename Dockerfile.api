# ─── Stage 1 : Build ───────────────────────────────────────────────────────────
FROM node:24-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# Workspace manifests (better layer caching)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.json tsconfig.base.json ./

COPY lib/api-spec/package.json          lib/api-spec/
COPY lib/api-client-react/package.json  lib/api-client-react/
COPY lib/api-zod/package.json           lib/api-zod/
COPY lib/db/package.json                lib/db/
COPY artifacts/api-server/package.json  artifacts/api-server/

RUN pnpm install --frozen-lockfile

COPY lib/               lib/
COPY artifacts/api-server/ artifacts/api-server/

# Build composite libs then the API bundle (esbuild → dist/index.mjs)
RUN pnpm run typecheck:libs
RUN pnpm --filter @workspace/api-server run build


# ─── Stage 2 : Runtime ─────────────────────────────────────────────────────────
FROM node:24-alpine AS runtime

WORKDIR /app

# The API bundle is a single self-contained file (esbuild)
COPY --from=builder /app/artifacts/api-server/dist ./dist

# lib/db + root node_modules needed for drizzle-kit migrations at startup
COPY --from=builder /app/lib/db ./lib/db
COPY --from=builder /app/node_modules ./node_modules

COPY docker/api-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
