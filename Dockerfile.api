# ─── Stage 1 : Build ───────────────────────────────────────────────────────────
FROM node:24 AS builder

WORKDIR /app

RUN npm install -g pnpm@10.26.1

# Workspace manifests (better layer caching)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.json tsconfig.base.json ./

COPY lib/api-spec/package.json          lib/api-spec/
COPY lib/api-client-react/package.json  lib/api-client-react/
COPY lib/api-zod/package.json           lib/api-zod/
COPY lib/db/package.json                lib/db/
COPY artifacts/api-server/package.json  artifacts/api-server/

RUN pnpm install --frozen-lockfile

COPY lib/               lib/
COPY artifacts/api-server/ artifacts/api-server/

# Build composite libs then the API bundle (esbuild → dist/index.mjs)
RUN pnpm run typecheck:libs
RUN pnpm --filter @workspace/api-server run build


# ─── Stage 2 : Runtime ─────────────────────────────────────────────────────────
FROM node:24-alpine AS runtime

WORKDIR /app

# Install drizzle-kit globally (bundles its own TS parser)
RUN npm install -g drizzle-kit

# Set up the db package with only what drizzle-kit needs at runtime
WORKDIR /app/lib/db
RUN npm install drizzle-orm pg

# Copy schema source and config (drizzle-kit reads these to push schema)
COPY --from=builder /app/lib/db/src ./src
COPY --from=builder /app/lib/db/drizzle.config.ts ./drizzle.config.ts

# Copy the API bundle (single self-contained esbuild output)
WORKDIR /app
COPY --from=builder /app/artifacts/api-server/dist ./dist

COPY docker/api-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
