# ── Base de données PostgreSQL ────────────────────────────────────────────────
# Mot de passe PostgreSQL (utilisé par le conteneur postgres ET l'API)
POSTGRES_PASSWORD=changeme_mot_de_passe_fort

# ── API Server ────────────────────────────────────────────────────────────────
# Secret pour les sessions (chaîne aléatoire d'au moins 32 caractères)
# Générer avec : openssl rand -hex 32
SESSION_SECRET=changeme_secret_session_tres_long_et_aleatoire

# ── Réseau ────────────────────────────────────────────────────────────────────
# Port exposé publiquement (défaut : 80)
# Mettre 443 si vous gérez SSL manuellement, sinon laisser 80 avec un reverse proxy (Traefik, Caddy, etc.)
HTTP_PORT=80
